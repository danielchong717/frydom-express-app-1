---
import Price from './Price.astro';
import BreakableText from './BreakableText.astro';
import {t,url,type Language} from '../lib/site';
/* tier sets how loudly an item reads on the menu:
   meal (combos) > spotlight (fried chicken) > standard (burgers, wraps, wings) > row (nuggets, sides) > mini (drinks). */
type Tier='meal'|'spotlight'|'standard'|'row'|'mini';
const {item,lang,tier='standard'}=Astro.props as {item:any,lang:Language,tier?:Tier};
const singlePrice=item.variants.filter((variant:any)=>variant.status!=='conflict').length===1;
const extras=item.labels.filter((label:string)=>!/Photo update|图片更新/.test(label));
const loud=tier==='meal'||tier==='spotlight';
const quiet=tier==='row'||tier==='mini';
---
<article class:list={['menu-item','menu-product','tier-'+tier,{'single-price':singlePrice}]} id={item.id} data-item-id={item.id}>
  <div class="item-photo"><img src={item.image.src} alt={'Frydom Express '+item.name} width={item.image.width} height={item.image.height} loading="lazy" decoding="async"/>{item.imageStatus==='update_pending'&&<span class="photo-note">{t(lang,'Photo update coming soon','图片更新中')}</span>}</div>
  <div class="item-body">
    {tier==='meal'&&<span class="meal-tag">{t(lang,'Meal','套餐')}</span>}
    <div class="product-meta">
      <h3><BreakableText text={item.name}/></h3>
      {loud&&<p class="item-description">{item.description}</p>}
      {quiet&&<p class="item-description sr-only">{item.description}</p>}
      <Price item={item} lang={lang}/>
    </div>
    {loud&&(item.offerKind||extras.length>0||item.notes.length>0)&&<div class="item-extras">
      {item.offerKind&&<a class="text-link" href={url(lang,item.offerKind)}>{t(lang,'View offer details','查看活动详情')} ↗</a>}
      {extras.map((label:string)=><p class="item-note">{label}</p>)}
      {item.notes.map((note:string)=><p class="item-note">{note}</p>)}
    </div>}
  </div>
  {tier==='standard'&&<details class="product-details">
      <summary aria-label={t(lang,'Details for '+item.name,'查看'+item.name+'详情')}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg></summary>
      <div class="product-detail-copy">
        <p class="item-description">{item.description}</p>
        {item.offerKind&&<a class="text-link" href={url(lang,item.offerKind)}>{t(lang,'View offer details','查看活动详情')} ↗</a>}
        {extras.map((label:string)=><p class="item-note">{label}</p>)}
        {item.notes.map((note:string)=><p class="item-note">{note}</p>)}
      </div>
  </details>}
</article>
